<!DOCTYPE html>
<html lang="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "en" : "pt-BR")" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <script src="@Assets["js/tema.js"]"></script>
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    @* Bibliotecas visuais pelo jsDelivr (liberado no CSP): icones, bandeiras e a fonte Inter. *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flag-icons@7.2.3/css/flag-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fontsource-variable/inter@5/index.min.css" />
    <link rel="stylesheet" href="@Assets["css/site.css"]" />
    <link rel="icon" href="favicon.ico" />
    <HeadOutlet @rendermode="ModoRenderizacao" />
</head>
<body>
    <Routes @rendermode="ModoRenderizacao" />
    <script src="@Assets["lib/bootstrap/dist/js/bootstrap.bundle.min.js"]"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="@Assets["js/site.js"]"></script>
    <script src="@Assets["js/graficos.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    // Telas de acesso (login, primeiro acesso, erro) sao renderizadas no servidor sem interatividade:
    // precisam do HttpContext para gravar o cookie de autenticacao.
    private IComponentRenderMode? ModoRenderizacao => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
