@* Rosca (Chart.js), ex.: eventos por fonte. *@
@inherits GraficoBase

<div class="grafico grafico-baixo"><canvas @ref="Canvas" role="img"></canvas></div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ItemRanking> Itens { get; set; } = [];

    protected override string Funcao => "rosca";

    protected override object Versao => Itens;

    protected override object MontarDados() => new
    {
        rotulos = Itens.Select(i => i.Rotulo),
        valores = Itens.Select(i => i.Quantidade)
    };
}
