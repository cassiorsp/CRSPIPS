@* Selos no topo: Worker online/offline e modo simulacao. Atualizados a cada troca de pagina. *@
@implements IDisposable
@inject ExecutorServicos Servicos
@inject NavigationManager Navegacao
@inject IStringLocalizer<Textos> T
@inject TimeProvider Relogio
@using CRSP.IPS.Application.Abstracoes

@if (_modoSimulacao)
{
    <a href="/Configuracoes" class="badge rounded-pill text-bg-info text-decoration-none d-none d-sm-inline-block" title="@T["Bloqueios automáticos são registrados, mas não aplicados no firewall."]">
        <i class="bi bi-eye"></i> @T["Modo simulação"]
    </a>
}
@if (_workerOnline)
{
    <span class="badge rounded-pill text-bg-success d-none d-sm-inline-block"><i class="bi bi-circle-fill small"></i> @T["Motor online"]</span>
}
else
{
    <span class="badge rounded-pill text-bg-danger d-none d-sm-inline-block" title="@T["O serviço CRSPIPS não está enviando sinal. Verifique o serviço do Windows."]">
        <i class="bi bi-exclamation-octagon"></i> @T["Motor offline"]
    </span>
}

@code {
    private bool _modoSimulacao;
    private bool _workerOnline;

    protected override async Task OnInitializedAsync()
    {
        Navegacao.LocationChanged += AoNavegar;
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _modoSimulacao = (await Servicos.ExecutarAsync((ServicoConfiguracao s) => s.ObterAsync())).ModoSimulacao;
        var status = await Servicos.ExecutarAsync((IRepositorioStatusWorker r) => r.ObterAsync());
        _workerOnline = status?.EstaOnline(Relogio.GetUtcNow().UtcDateTime) ?? false;
    }

    private void AoNavegar(object? remetente, LocationChangedEventArgs args) => _ = InvokeAsync(async () =>
    {
        await CarregarAsync();
        StateHasChanged();
    });

    public void Dispose() => Navegacao.LocationChanged -= AoNavegar;
}
