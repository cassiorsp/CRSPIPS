@page "/Bloqueios/Detalhe"

<Titulo Texto="@T["Detalhe do IP"]" />

<div class="pagina-cheia">
<div class="mb-3">
    <a href="/Bloqueios" class="small"><i class="bi bi-arrow-left"></i> @T["Voltar para bloqueios"]</a>
</div>

@if (_detalhe is { } detalhe)
{
    var local = detalhe.Localizacao;
    <div class="card cartao mb-3">
        <div class="card-body d-flex flex-wrap gap-4 align-items-center">
            <div class="bandeira-grande"><Bandeira Codigo="@local?.PaisCodigo" /></div>
            <div>
                <div class="ip-grande fonte-mono">@detalhe.Ip</div>
                <div class="text-body-secondary">@(Exibicao.DescreverLocal(local) ?? "—")</div>
                <div class="d-flex flex-wrap gap-2 mt-2">
                    @if (detalhe.Protegido)
                    {
                        <span class="badge text-bg-success"><i class="bi bi-shield-check"></i> @T["Protegido"]: @T[detalhe.MotivoProtecao ?? string.Empty]</span>
                    }
                    @if (detalhe.NaListaNegra)
                    {
                        <span class="badge text-bg-dark"><i class="bi bi-slash-circle"></i> @T["Lista negra"]</span>
                    }
                    @foreach (var (lista, referencia) in detalhe.ListasExternas)
                    {
                        @if (referencia is not null && referencia.StartsWith("SBL", StringComparison.OrdinalIgnoreCase))
                        {
                            <a class="badge text-bg-danger text-decoration-none" href="https://check.spamhaus.org/sbl/query/@referencia" target="_blank" rel="noopener noreferrer">
                                <i class="bi bi-cloud-download"></i> @lista · @referencia
                            </a>
                        }
                        else
                        {
                            <span class="badge text-bg-danger"><i class="bi bi-cloud-download"></i> @lista@(referencia is null ? "" : $" · {referencia}")</span>
                        }
                    }
                    @if (detalhe.BloqueioAtivo is { } ativo)
                    {
                        var situacao = Exibicao.SituacaoBloqueio(ativo);
                        <span class="badge @situacao.Classe">@T[situacao.Texto] · @(ativo.EhPermanente ? T["Permanente"] : T["até {0}", Exibicao.DataHora(ativo.ExpiraEm)])</span>
                    }
                    else if (!detalhe.NaListaNegra)
                    {
                        <span class="badge text-bg-secondary">@T["Sem bloqueio ativo"]</span>
                    }
                </div>
            </div>
            <div class="ms-auto d-flex flex-wrap gap-2">
                @if (detalhe.BloqueioAtivo is { } bloqueioAtivo)
                {
                    <button class="btn btn-success" type="button" disabled="@_processando" @onclick="() => DesbloquearAsync(bloqueioAtivo.Id)"><i class="bi bi-unlock"></i> @T["Desbloquear"]</button>
                }
                else if (!detalhe.Protegido)
                {
                    <div class="d-flex gap-2">
                        <SeletorDuracao @bind-Valor="_duracao" />
                        <button class="btn btn-danger text-nowrap" type="button" disabled="@_processando" @onclick="BloquearAsync"><i class="bi bi-slash-circle"></i> @T["Bloquear"]</button>
                    </div>
                }
                @if (!detalhe.Protegido)
                {
                    <button class="btn btn-outline-success" type="button" disabled="@_processando" @onclick="ListaBrancaAsync"><i class="bi bi-shield-check"></i> @T["Lista branca"]</button>
                }
                <a class="btn btn-outline-secondary" href="https://www.abuseipdb.com/check/@detalhe.Ip" target="_blank" rel="noopener noreferrer">
                    <i class="bi bi-box-arrow-up-right"></i> AbuseIPDB
                </a>
            </div>
        </div>
    </div>

    <div class="cartao-cheio">
    <ul class="nav nav-tabs mb-0" role="tablist">
        <li class="nav-item">
            <button class="nav-link @(_abaEventos ? "" : "active")" type="button" role="tab" @onclick="() => _abaEventos = false">
                @T["Histórico de bloqueios"] <span class="badge text-bg-secondary">@detalhe.Historico.Count</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_abaEventos ? "active" : "")" type="button" role="tab" @onclick="() => _abaEventos = true">
                @T["Eventos registrados"] <span class="badge text-bg-secondary">@detalhe.Eventos.Count</span>
            </button>
        </li>
    </ul>
    <div class="card cartao cartao-cheio border-top-0 rounded-top-0">
        <div class="table-responsive tabela-rolagem">
            @if (!_abaEventos)
            {
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead><tr><th>@T["Bloqueado em"]</th><th>@T["Motivo"]</th><th>@T["Origem"]</th><th class="text-center">@T["Nível"]</th><th class="text-end">@T["Ocorr."]</th><th>@T["Expira em"]</th><th>@T["Encerrado"]</th><th>@T["Situação"]</th><th>@T["Comentário"]</th></tr></thead>
                    <tbody>
                    @foreach (var bloqueio in detalhe.Historico)
                    {
                        var situacao = Exibicao.SituacaoBloqueio(bloqueio);
                        <tr>
                            <td class="small">@Exibicao.DataHora(bloqueio.BloqueadoEm)</td>
                            <td>@T[bloqueio.Motivo]</td>
                            <td class="small">@T[Exibicao.Rotulo(bloqueio.Origem)] · @bloqueio.CriadoPor</td>
                            <td class="text-center">@bloqueio.NivelReincidencia</td>
                            <td class="text-end">@bloqueio.Ocorrencias</td>
                            <td class="small">@(bloqueio.EhPermanente ? T["Permanente"] : Exibicao.DataHora(bloqueio.ExpiraEm))</td>
                            <td class="small">@Exibicao.DataHora(bloqueio.EncerradoEm) @bloqueio.EncerradoPor</td>
                            <td><span class="badge @situacao.Classe">@T[situacao.Texto]</span></td>
                            <td class="small text-break">@bloqueio.Comentario</td>
                        </tr>
                    }
                    @if (detalhe.Historico.Count == 0)
                    {
                        <tr><td colspan="9" class="text-body-secondary">@T["Este IP nunca foi bloqueado."]</td></tr>
                    }
                    </tbody>
                </table>
            }
            else
            {
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead><tr><th>@T["Quando"]</th><th>@T["Fonte"]</th><th>@T["Regra"]</th><th>@T["Site"]</th><th>@T["Requisição"]</th><th>@T["Status"]</th><th>@T["Detalhe"]</th></tr></thead>
                    <tbody>
                    @foreach (var evento in detalhe.Eventos)
                    {
                        <tr>
                            <td class="small text-nowrap">@Exibicao.DataHora(evento.OcorridoEmUtc)</td>
                            <td class="small">@T[Exibicao.Rotulo(evento.Fonte)]</td>
                            <td class="small">@(evento.Regra ?? T["Política de países"])</td>
                            <td class="small text-nowrap">@(evento.Site ?? "—")</td>
                            <td class="small fonte-mono text-break">@evento.Metodo @evento.Url</td>
                            <td>@evento.CodigoStatus</td>
                            <td class="small text-break">@(evento.Detalhe ?? evento.UserAgent)</td>
                        </tr>
                    }
                    @if (detalhe.Eventos.Count == 0)
                    {
                        <tr><td colspan="7" class="text-body-secondary">@T["Nenhum evento registrado para este IP."]</td></tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
    </div>
}
</div>

@code {
    [SupplyParameterFromQuery(Name = "ip")] private string? Ip { get; set; }

    private DetalheIp? _detalhe;
    private string _duracao = "24h";
    private bool _abaEventos;
    private bool _processando;

    protected override async Task OnParametersSetAsync() => await CarregarAsync();

    private async Task CarregarAsync()
    {
        var resultado = await Servicos.ExecutarAsync((ServicoBloqueios s) => s.ObterDetalheAsync(Ip ?? string.Empty));
        if (!resultado.Sucesso || resultado.Valor is null)
        {
            Avisos.Erro(resultado.Erro ?? "IP inválido.");
            _detalhe = null;
            return;
        }

        _detalhe = resultado.Valor;
    }

    private Task BloquearAsync() => ExecutarAsync(async () =>
    {
        if (!Exibicao.TentarConverterDuracao(_duracao, out var tempo))
            return Resultado.Falha("Duração inválida.");
        return await Servicos.ExecutarAsync((ServicoBloqueios s) => s.BloquearManualAsync(_detalhe!.Ip, tempo, null));
    }, "Bloqueio registrado. O firewall será atualizado em instantes.");

    private Task DesbloquearAsync(int id) => ExecutarAsync(
        () => Servicos.ExecutarAsync((ServicoBloqueios s) => s.DesbloquearAsync(id, null)),
        "IP liberado. O firewall será atualizado em instantes.");

    private async Task ListaBrancaAsync()
    {
        if (!await ConfirmarAsync(T["Adicionar {0} à lista branca? O IP nunca mais será bloqueado.", _detalhe!.Ip]))
            return;
        await ExecutarAsync(
            () => Servicos.ExecutarAsync((ServicoListas s) => s.AdicionarAsync(TipoLista.Branca, _detalhe.Ip, "Incluído pela tela de bloqueios")),
            "IP adicionado à lista branca e liberado.");
    }

    private async Task ExecutarAsync(Func<Task<Resultado>> acao, string mensagemSucesso)
    {
        _processando = true;
        try
        {
            Avisos.Mostrar(await acao(), mensagemSucesso);
            await CarregarAsync();
        }
        finally
        {
            _processando = false;
        }
    }
}
