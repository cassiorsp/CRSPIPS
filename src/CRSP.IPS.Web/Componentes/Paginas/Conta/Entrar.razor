@page "/Conta/Entrar"
@using System.ComponentModel.DataAnnotations
@inject LimitadorLogin Limitador
@inject CRSP.IPS.Application.Abstracoes.IContextoUsuario ContextoUsuario

<PageTitle>@T["Entrar"] · CRSPIPS</PageTitle>

<EditForm Model="Entrada" FormName="entrar" OnValidSubmit="EntrarAsync" method="post" novalidate>
    <DataAnnotationsValidator />
    @if (_erro is not null)
    {
        <div class="alert alert-danger py-2 small">@T[_erro]</div>
    }
    <div class="mb-3">
        <label class="form-label" for="email">@T["E-mail"]</label>
        <InputText id="email" class="form-control" autocomplete="username" autofocus @bind-Value="Entrada.Email" />
        <MensagemValidacao Para="() => Entrada.Email" />
    </div>
    <div class="mb-4">
        <label class="form-label" for="senha">@T["Senha"]</label>
        <InputText id="senha" type="password" class="form-control" autocomplete="current-password" @bind-Value="Entrada.Senha" />
        <MensagemValidacao Para="() => Entrada.Senha" />
    </div>
    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-box-arrow-in-right me-1"></i>@T["Entrar"]</button>
</EditForm>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromForm(FormName = "entrar")] private DadosEntrada Entrada { get; set; } = null!;

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private string? _erro;

    protected override async Task OnInitializedAsync()
    {
        Entrada ??= new DadosEntrada();
        if (!HttpMethods.IsGet(HttpContext.Request.Method))
            return;

        if (!await Servicos.ExecutarAsync((ServicoUsuarios s) => s.ExisteAlgumAsync()))
            Navegacao.NavigateTo("/Conta/PrimeiroAcesso");
        else if (HttpContext.User.Identity?.IsAuthenticated == true)
            Navegacao.NavigateTo("/");
    }

    private async Task EntrarAsync()
    {
        if (!Limitador.Permitir(ContextoUsuario.Ip))
        {
            _erro = "Muitas tentativas. Aguarde um minuto e tente novamente.";
            return;
        }

        var resultado = await Servicos.ExecutarAsync((ServicoUsuarios s) => s.AutenticarAsync(Entrada.Email, Entrada.Senha, ContextoUsuario.Ip));
        if (!resultado.Sucesso || resultado.Valor is null)
        {
            _erro = resultado.Erro ?? "E-mail ou senha inválidos.";
            return;
        }

        await SessaoUsuario.EntrarAsync(HttpContext, resultado.Valor);
        Navegacao.NavigateTo(SessaoUsuario.RetornoSeguro(ReturnUrl), forceLoad: true);
    }

    private sealed class DadosEntrada
    {
        [Required(ErrorMessage = "Campo obrigatório.")]
        [EmailAddress(ErrorMessage = "Informe um e-mail válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Campo obrigatório.")]
        public string Senha { get; set; } = string.Empty;
    }
}
