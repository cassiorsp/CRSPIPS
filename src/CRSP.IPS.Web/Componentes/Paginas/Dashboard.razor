@page "/"
@implements IDisposable

<Titulo Texto="@T["Dashboard"]" />

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <div class="btn-group btn-group-sm filtro-periodo" role="group" aria-label="@T["Período"]">
        @foreach (var opcao in Periodos)
        {
            <a class="btn @(opcao == _periodo ? "btn-primary" : "btn-outline-primary")" href="@UrlPeriodo(opcao)">@T[Exibicao.Rotulo(opcao)]</a>
        }
    </div>
    <div class="ms-auto d-flex align-items-center gap-2 small text-body-secondary">
        <span class="ponto-vivo @(_pausado ? "pausado" : "")"></span>
        <span>@TextoAtualizacao</span>
        <button class="btn btn-sm btn-link p-0 text-decoration-none" type="button" @onclick="() => _pausado = !_pausado">
            <i class="bi @(_pausado ? "bi-play" : "bi-pause")"></i> @(_pausado ? T["Continuar"] : T["Pausar"])
        </button>
        <button class="btn btn-sm btn-link p-0 text-decoration-none" type="button" title="@T["Atualizar agora"]" @onclick="CarregarAsync">
            <i class="bi bi-arrow-clockwise"></i>
        </button>
    </div>
</div>

@if (_indicadores is { } indicadores)
{
    var worker = indicadores.Worker;

    @if (indicadores.ModoSimulacao)
    {
        <div class="alert alert-info d-flex align-items-center gap-2">
            <i class="bi bi-eye fs-5"></i>
            <div>
                <strong>@T["Modo simulação ativo."]</strong>
                @T["Os bloqueios automáticos são registrados, mas não são aplicados no firewall. Bloqueios manuais e a lista negra são aplicados normalmente."]
                <a href="/Configuracoes" class="alert-link">@T["Configurações"]</a>
            </div>
        </div>
    }
    @if (indicadores.Periodo == PeriodoDashboard.Tudo || (int)indicadores.Periodo > indicadores.RetencaoEventosDias)
    {
        <div class="alert alert-secondary small py-2">
            <i class="bi bi-info-circle me-1"></i>@T["Os eventos são mantidos por {0} dias (Configurações). Para períodos maiores, os números de eventos cobrem só esse intervalo; os bloqueios cobrem o período inteiro.", indicadores.RetencaoEventosDias]
        </div>
    }

    <div class="row g-3 mb-3">
        <div class="col-6 col-xl-3">
            <div class="card cartao kpi kpi-perigo">
                <div class="card-body">
                    <div class="kpi-icone"><i class="bi bi-shield-lock"></i></div>
                    <div class="kpi-valor">@indicadores.BloqueiosAtivos.ToString("N0")</div>
                    <div class="kpi-rotulo" title="@T["IPs bloqueados no período que continuam bloqueados agora."]">@T["Bloqueios ativos"] <span class="kpi-periodo">(@_textoPeriodo)</span></div>
                    @if (indicadores.BloqueiosSimuladosAtivos > 0)
                    {
                        <div class="kpi-extra">@T["+{0} simulados", indicadores.BloqueiosSimuladosAtivos]</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card cartao kpi kpi-alerta">
                <div class="card-body">
                    <div class="kpi-icone"><i class="bi bi-calendar-x"></i></div>
                    <div class="kpi-valor">@indicadores.BloqueiosNoPeriodo.ToString("N0")</div>
                    <div class="kpi-rotulo">@T["Ataques mitigados"] <span class="kpi-periodo">(@_textoPeriodo)</span></div>
                    @if (indicadores.BloqueiosSimuladosNoPeriodo > 0)
                    {
                        <div class="kpi-extra">@T["+{0} simulados", indicadores.BloqueiosSimuladosNoPeriodo]</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card cartao kpi kpi-info">
                <div class="card-body">
                    <div class="kpi-icone"><i class="bi bi-activity"></i></div>
                    <div class="kpi-valor">@indicadores.EventosNoPeriodo.ToString("N0")</div>
                    <div class="kpi-rotulo" title="@T["Eventos que casaram com alguma regra. Amostras limitadas a 20 por IP, regra e hora."]">@T["Eventos suspeitos"] <span class="kpi-periodo">(@_textoPeriodo)</span></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card cartao kpi kpi-neutro">
                <div class="card-body">
                    <div class="kpi-icone"><i class="bi bi-globe2"></i></div>
                    <div class="kpi-valor">@indicadores.PaisesNoPeriodo.ToString("N0")</div>
                    <div class="kpi-rotulo">@T["Países com eventos suspeitos"] <span class="kpi-periodo">(@_textoPeriodo)</span></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-xl-8">
            <div class="card cartao h-100">
                <div class="card-header">@T["Eventos e bloqueios"] <span class="text-body-secondary small">(@_textoPeriodo)</span></div>
                <div class="card-body">
                    <GraficoLinha Rotulos="_graficos.Rotulos"
                                  Eventos="_graficos.Eventos"
                                  Bloqueios="_graficos.Bloqueios"
                                  RotuloEventos="@T["Eventos suspeitos"]"
                                  RotuloBloqueios="@T["Bloqueios"]" />
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card cartao h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>@T["Motor (Worker)"]</span>
                    @if (indicadores.WorkerOnline)
                    {
                        <span class="badge text-bg-success">@T["Online"]</span>
                    }
                    else
                    {
                        <span class="badge text-bg-danger">@T["Offline"]</span>
                    }
                </div>
                <div class="card-body">
                    @if (worker is null)
                    {
                        <p class="text-body-secondary mb-0">@T["O serviço CRSPIPS ainda não foi iniciado neste servidor."]</p>
                    }
                    else
                    {
                        <dl class="lista-dados mb-0">
                            <dt>@T["Servidor"]</dt><dd>@worker.Maquina <span class="text-body-secondary">v@(worker.Versao)</span></dd>
                            <dt>@T["Último sinal"]</dt><dd>@Exibicao.DataHora(worker.UltimoSinalEm)</dd>
                            <dt>@T["Última sincronização"]</dt><dd>@Exibicao.DataHora(worker.UltimaSincronizacaoEm)</dd>
                            <dt>@T["Endereços no firewall"]</dt><dd>@worker.EnderecosNoFirewall.ToString("N0") <span class="text-body-secondary">(@T["{0} regras", worker.RegrasNoFirewall])</span></dd>
                            <dt>@T["Eventos processados"]</dt><dd>@worker.EventosProcessados.ToString("N0")</dd>
                            <dt>@T["Política de países"]</dt>
                            <dd>
                                @T[Exibicao.Rotulo(indicadores.ModoPaises)]
                                @if (!string.IsNullOrEmpty(worker.ResumoPoliticaPaises))
                                {
                                    <div class="small text-body-secondary">@worker.ResumoPoliticaPaises</div>
                                }
                            </dd>
                            @if (!string.IsNullOrEmpty(worker.UltimoErro))
                            {
                                <dt class="text-danger">@T["Último erro"]</dt>
                                <dd class="text-danger small">@Exibicao.DataHora(worker.UltimoErroEm): @worker.UltimoErro</dd>
                            }
                        </dl>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-5">
            <div class="card cartao h-100">
                <div class="card-header">@T["Eventos por fonte"] <span class="text-body-secondary small">(@_textoPeriodo)</span></div>
                <div class="card-body">
                    @if (indicadores.EventosPorFonte.Count == 0)
                    {
                        <p class="text-body-secondary mb-0">@T["Sem eventos no período."]</p>
                    }
                    else
                    {
                        <GraficoRosca Itens="_graficos.Fontes" />
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="card cartao h-100">
                <div class="card-header">@T["Países com mais bloqueios"] <span class="text-body-secondary small">(@_textoPeriodo)</span></div>
                <div class="card-body">
                    @if (indicadores.TopPaises.Count == 0)
                    {
                        <p class="text-body-secondary mb-0">@T["Sem bloqueios no período."]</p>
                    }
                    else
                    {
                        <GraficoBarras Itens="_graficos.Paises" RotuloSerie="@T["Bloqueios"]" />
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-xl-6">
            <div class="card cartao h-100">
                <div class="card-header">@T["IPs agressores mais frequentes"] <span class="text-body-secondary small">(@_textoPeriodo)</span></div>
                <div class="table-responsive tabela-rolagem tabela-rolagem-baixa">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead><tr><th>@T["IP"]</th><th>@T["País"]</th><th class="text-end">@T["Bloqueios"]</th><th class="text-end" title="@T["Eventos suspeitos registrados no período (amostras limitadas a 20 por IP, regra e hora)."]">@T["Eventos"]</th></tr></thead>
                        <tbody>
                        @foreach (var item in indicadores.TopIps)
                        {
                            <tr>
                                <td><a href="@UrlDetalhe(item.Ip)" class="fonte-mono">@item.Ip</a></td>
                                <td><Bandeira Codigo="@item.PaisCodigo" /> <span class="small">@Exibicao.NomePais(item.PaisCodigo)</span></td>
                                <td class="text-end">@item.Bloqueios.ToString("N0")</td>
                                <td class="text-end">@item.Eventos.ToString("N0")</td>
                            </tr>
                        }
                        @if (indicadores.TopIps.Count == 0)
                        {
                            <tr><td colspan="4" class="text-body-secondary">@T["Sem eventos no período."]</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card cartao h-100">
                <div class="card-header d-flex justify-content-between">
                    <span>@T["Bloqueios recentes"] <span class="text-body-secondary small">(@_textoPeriodo)</span></span>
                    <a href="/Bloqueios" class="small">@T["Ver todos"]</a>
                </div>
                <div class="table-responsive tabela-rolagem tabela-rolagem-baixa">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead><tr><th>@T["IP"]</th><th>@T["Motivo"]</th><th>@T["Quando"]</th><th>@T["Situação"]</th></tr></thead>
                        <tbody>
                        @foreach (var bloqueio in indicadores.BloqueiosRecentes)
                        {
                            var situacao = Exibicao.SituacaoBloqueio(bloqueio);
                            <tr>
                                <td class="text-nowrap"><Bandeira Codigo="@bloqueio.PaisCodigo" /> <a href="@UrlDetalhe(bloqueio.Ip)" class="fonte-mono">@bloqueio.Ip</a></td>
                                <td class="text-truncate celula-motivo">@T[bloqueio.Motivo]</td>
                                <td class="small text-nowrap">@Exibicao.DataHora(bloqueio.BloqueadoEm)</td>
                                <td><span class="badge @situacao.Classe">@T[situacao.Texto]</span></td>
                            </tr>
                        }
                        @if (indicadores.BloqueiosRecentes.Count == 0)
                        {
                            <tr><td colspan="4" class="text-body-secondary">@T["Sem bloqueios no período."]</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="card cartao">
                <div class="card-header">@T["URLs mais atacadas"] <span class="text-body-secondary small">(@_textoPeriodo)</span></div>
                <div class="table-responsive tabela-rolagem tabela-rolagem-baixa">
                    <table class="table table-sm table-hover mb-0">
                        <thead><tr><th>@T["URL"]</th><th class="text-end">@T["Ocorrências"]</th></tr></thead>
                        <tbody>
                        @foreach (var item in indicadores.TopUrls)
                        {
                            <tr><td class="fonte-mono text-break">@item.Rotulo</td><td class="text-end">@item.Quantidade.ToString("N0")</td></tr>
                        }
                        @if (indicadores.TopUrls.Count == 0)
                        {
                            <tr><td colspan="2" class="text-body-secondary">@T["Sem eventos no período."]</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private static readonly PeriodoDashboard[] Periodos =
    [
        PeriodoDashboard.Hoje, PeriodoDashboard.Dias7, PeriodoDashboard.Dias14, PeriodoDashboard.Dias30, PeriodoDashboard.Dias90,
        PeriodoDashboard.Dias120, PeriodoDashboard.Dias180, PeriodoDashboard.Dias360, PeriodoDashboard.Tudo
    ];

    private static readonly TimeSpan IntervaloAtualizacao = TimeSpan.FromSeconds(30);

    [SupplyParameterFromQuery(Name = "periodo")]
    private string? PeriodoTexto { get; set; }

    private PeriodoDashboard _periodo = PeriodoDashboard.Hoje;
    private IndicadoresDashboard? _indicadores;
    private DadosGraficos _graficos = new([], [], [], [], []);
    private string _textoPeriodo = string.Empty;
    private DateTime _ultimaAtualizacao = DateTime.UtcNow;
    private bool _pausado;
    private readonly CancellationTokenSource _cancelamento = new();

    protected override async Task OnParametersSetAsync()
    {
        _periodo = Periodos.FirstOrDefault(p => Exibicao.Rotulo(p).Equals(PeriodoTexto, StringComparison.OrdinalIgnoreCase), PeriodoDashboard.Hoje);
        _textoPeriodo = T[Exibicao.DescreverPeriodo(_periodo), (int)_periodo];
        await CarregarAsync();
    }

    protected override void OnAfterRender(bool primeiraRenderizacao)
    {
        if (primeiraRenderizacao && RendererInfo.IsInteractive)
            _ = AtualizarPeriodicamenteAsync();
    }

    private async Task CarregarAsync()
    {
        _indicadores = await Servicos.ExecutarAsync((ServicoPainel s) => s.ObterIndicadoresAsync(_periodo));
        var indicadores = _indicadores;
        // Montados uma vez por carga: os graficos so redesenham quando estas listas mudam.
        _graficos = new DadosGraficos(
            indicadores.SerieEventos.Select(p => Exibicao.RotuloSerie(p.Inicio, indicadores.Granularidade)).ToList(),
            indicadores.SerieEventos.Select(p => p.Quantidade).ToList(),
            indicadores.SerieBloqueios.Select(p => p.Quantidade).ToList(),
            indicadores.EventosPorFonte.Select(f => new ItemRanking(RotuloFonte(f.Rotulo), f.Quantidade)).ToList(),
            indicadores.TopPaises.Select(p => new ItemRanking(Exibicao.NomePais(p.Rotulo, p.Complemento), p.Quantidade)).ToList());
        _ultimaAtualizacao = DateTime.UtcNow;
    }

    private sealed record DadosGraficos(
        IReadOnlyList<string> Rotulos,
        IReadOnlyList<int> Eventos,
        IReadOnlyList<int> Bloqueios,
        IReadOnlyList<ItemRanking> Fontes,
        IReadOnlyList<ItemRanking> Paises);

    /// <summary>Recarrega a cada 30 s (exceto pausado); o texto "Atualizado ha X s" e redesenhado a cada 5 s.</summary>
    private async Task AtualizarPeriodicamenteAsync()
    {
        using var temporizador = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await temporizador.WaitForNextTickAsync(_cancelamento.Token))
            {
                await InvokeAsync(async () =>
                {
                    if (!_pausado && DateTime.UtcNow - _ultimaAtualizacao >= IntervaloAtualizacao)
                        await CarregarAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private string TextoAtualizacao
    {
        get
        {
            var segundos = (int)(DateTime.UtcNow - _ultimaAtualizacao).TotalSeconds;
            return segundos < 5 ? T["Atualizado agora"] : T["Atualizado há {0} s", segundos];
        }
    }

    private static string UrlPeriodo(PeriodoDashboard periodo) =>
        periodo == PeriodoDashboard.Hoje ? "/" : $"/?periodo={Exibicao.Rotulo(periodo).ToLowerInvariant()}";

    private static string UrlDetalhe(string ip) => $"/Bloqueios/Detalhe?ip={Uri.EscapeDataString(ip)}";

    private string RotuloFonte(string fonte) =>
        Enum.TryParse<TipoFonte>(fonte, out var tipo) ? T[Exibicao.Rotulo(tipo)] : fonte;

    public void Dispose()
    {
        _cancelamento.Cancel();
        _cancelamento.Dispose();
    }
}
