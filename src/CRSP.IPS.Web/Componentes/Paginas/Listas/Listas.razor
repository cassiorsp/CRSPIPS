@page "/Listas"

<Titulo Texto="@T["Listas"]" />

<div class="pagina-cheia">
<AbasListas Atual="@(EhListaBranca ? "Branca" : "Negra")" />

<div class="row g-3 linha-cheia">
    <div class="col-xl-8">
        <div class="card cartao cartao-cheio">
            <div class="card-body border-bottom">
                <form class="row g-2 align-items-end" @onsubmit="AdicionarAsync" @onsubmit:preventDefault>
                    <div class="col-md-4">
                        <label class="form-label small" for="faixa">@T["IP, CIDR ou intervalo"]</label>
                        <input class="form-control fonte-mono" id="faixa" @bind="_faixa" placeholder="203.0.113.0/24" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small" for="descricao">@T["Descrição"]</label>
                        <input class="form-control" id="descricao" maxlength="300" @bind="_descricao" />
                    </div>
                    <div class="col-md-2">
                        <button class="btn @(EhListaBranca ? "btn-success" : "btn-dark") w-100" type="submit" disabled="@_processando"><i class="bi bi-plus-lg"></i> @T["Adicionar"]</button>
                    </div>
                </form>
            </div>
            <div class="card-body border-bottom">
                <div class="d-flex flex-wrap align-items-end gap-2">
                    <div class="flex-grow-1">
                        <label class="form-label small" for="arquivoCsv">@T["Importar arquivo CSV"]</label>
                        <InputFile id="arquivoCsv" class="form-control form-control-sm" accept=".csv,.txt,text/csv" OnChange="ImportarAsync" disabled="@_processando" />
                    </div>
                    <a class="btn btn-sm btn-outline-secondary" href="/Listas/modelo.csv" download><i class="bi bi-filetype-csv"></i> @T["Baixar modelo CSV"]</a>
                </div>
                <div class="form-text">@T["Colunas: faixa;descricao (a descrição é opcional). Separador ponto e vírgula ou vírgula, até 5.000 linhas e 1 MB. Linhas repetidas ou já cadastradas são ignoradas."]</div>
                @if (_importacao is { } importacao)
                {
                    <div class="alert @(importacao.Erros.Count == 0 ? "alert-success" : "alert-warning") small mt-2 mb-0">
                        <div>
                            <strong>@T["Importação concluída:"]</strong>
                            @T["{0} adicionada(s), {1} já existente(s) ou repetida(s), {2} com erro.", importacao.Adicionadas, importacao.Duplicadas, importacao.Erros.Count]
                        </div>
                        @if (importacao.Erros.Count > 0)
                        {
                            <ul class="lista-erros-importacao mb-0 mt-1">
                                @foreach (var erro in importacao.Erros)
                                {
                                    <li>@T["Linha {0}", erro.Linha]: <code>@erro.Valor</code> — @T[erro.Mensagem]</li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
            <div class="table-responsive tabela-rolagem">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>@T["Faixa"]</th><th>@T["Descrição"]</th><th>@T["Incluído em"]</th><th>@T["Por"]</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var entrada in _entradas)
                    {
                        <tr @key="entrada.Id">
                            <td class="fonte-mono">
                                @entrada.Faixa
                                @if (entrada.Sistema)
                                {
                                    <span class="badge text-bg-secondary ms-1">@T["Sistema"]</span>
                                }
                            </td>
                            <td>@T[entrada.Descricao ?? string.Empty]</td>
                            <td class="small">@Exibicao.DataHora(entrada.CriadaEm)</td>
                            <td class="small">@entrada.CriadaPor</td>
                            <td class="text-end">
                                @if (!entrada.Sistema)
                                {
                                    <button class="btn btn-sm btn-outline-danger" type="button" title="@T["Remover"]" @onclick="() => RemoverAsync(entrada)"><i class="bi bi-trash"></i></button>
                                }
                            </td>
                        </tr>
                    }
                    @if (_entradas.Count == 0)
                    {
                        <tr><td colspan="5" class="text-body-secondary">@T["Lista vazia."]</td></tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="card-footer small text-body-secondary">@T["{0} registro(s)", _entradas.Count]</div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card cartao">
            <div class="card-header"><i class="bi bi-info-circle me-1"></i>@(EhListaBranca ? T["Lista branca"] : T["Lista negra"])</div>
            <div class="card-body small">
                @if (EhListaBranca)
                {
                    <p>@T["Endereços da lista branca nunca são bloqueados, nem por regra nem manualmente. Ao incluir uma faixa, os bloqueios ativos dentro dela são liberados."]</p>
                    <p>@T["Inclua aqui o IP fixo da empresa, VPN, monitoramento e parceiros de integração."]</p>
                    <p class="mb-0 text-warning-emphasis"><i class="bi bi-exclamation-triangle"></i> @T["Se o servidor fica atrás de NAT ou proxy e os logs mostram um IP interno para todo o tráfego, mantenha as redes privadas aqui: bloquear o proxy derrubaria todos os acessos."]</p>
                }
                else
                {
                    <p>@T["Endereços da lista negra são bloqueados permanentemente no firewall, em todas as portas."]</p>
                    <p class="mb-0">@T["Não é possível incluir faixas que contenham endereços protegidos."]</p>
                }
                <hr />
                <p class="mb-0 text-body-secondary">@T["Formatos aceitos:"] <code>203.0.113.7</code> · <code>203.0.113.0/24</code> · <code>203.0.113.1-203.0.113.50</code> · <code>2001:db8::/32</code></p>
            </div>
        </div>
    </div>
</div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "tipo")] private string? TipoTexto { get; set; }

    private TipoLista _tipo = TipoLista.Branca;
    private bool EhListaBranca => _tipo == TipoLista.Branca;
    private IReadOnlyList<EntradaLista> _entradas = [];
    private ResultadoImportacao? _importacao;
    private string? _faixa;
    private string? _descricao;
    private bool _processando;

    protected override async Task OnParametersSetAsync()
    {
        _tipo = Enum.TryParse<TipoLista>(TipoTexto, ignoreCase: true, out var tipo) ? tipo : TipoLista.Branca;
        _importacao = null;
        await CarregarAsync();
    }

    private async Task CarregarAsync() => _entradas = await Servicos.ExecutarAsync((ServicoListas s) => s.ListarAsync(_tipo));

    private async Task AdicionarAsync()
    {
        _processando = true;
        try
        {
            var resultado = await Servicos.ExecutarAsync((ServicoListas s) => s.AdicionarAsync(_tipo, _faixa ?? string.Empty, _descricao));
            if (Avisos.Mostrar(resultado, EhListaBranca ? "Adicionado à lista branca." : "Adicionado à lista negra."))
            {
                _faixa = null;
                _descricao = null;
            }
            await CarregarAsync();
        }
        finally
        {
            _processando = false;
        }
    }

    private async Task ImportarAsync(InputFileChangeEventArgs args)
    {
        _importacao = null;
        if (args.File.Size > ArquivoCsvListas.TamanhoMaximoBytes)
        {
            Avisos.Erro("O arquivo passa de 1 MB. Divida em arquivos menores.");
            return;
        }

        _processando = true;
        try
        {
            await using var fluxo = args.File.OpenReadStream(ArquivoCsvListas.TamanhoMaximoBytes);
            var linhas = await ArquivoCsvListas.LerAsync(fluxo);
            var resultado = await Servicos.ExecutarAsync((ServicoListas s) => s.ImportarAsync(_tipo, linhas));
            if (!resultado.Sucesso)
            {
                Avisos.Erro(resultado.Erro!);
                return;
            }

            _importacao = resultado.Valor;
            Avisos.Fechar();
            await CarregarAsync();
        }
        finally
        {
            _processando = false;
        }
    }

    private async Task RemoverAsync(EntradaLista entrada)
    {
        if (!await ConfirmarAsync(T["Remover {0}?", entrada.Faixa]))
            return;
        Avisos.Mostrar(await Servicos.ExecutarAsync((ServicoListas s) => s.RemoverAsync(entrada.Id)), "Registro removido.");
        await CarregarAsync();
    }
}
