@page "/Regras/Editar"
@using System.ComponentModel.DataAnnotations

<Titulo Texto="@(Id is null ? T["Nova regra"] : T["Editar regra"])" />

<div class="mb-3">
    <a href="/Regras" class="small"><i class="bi bi-arrow-left"></i> @T["Voltar para regras"]</a>
</div>
<div class="row g-3">
    <div class="col-xl-7">
        <div class="card cartao">
            <div class="card-body">
                <EditForm Model="_dados" OnValidSubmit="SalvarAsync" novalidate>
                    <DataAnnotationsValidator />
                    @if (_erro is not null)
                    {
                        <div class="alert alert-danger py-2 small">@T[_erro]</div>
                    }
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label" for="nome">@T["Nome"]</label>
                            <InputText id="nome" class="form-control" @bind-Value="_dados.Nome" />
                            <MensagemValidacao Para="() => _dados.Nome" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                <InputCheckbox id="ativa" class="form-check-input" role="switch" @bind-Value="_dados.Ativa" />
                                <label class="form-check-label" for="ativa">@T["Ativa"]</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="descricao">@T["Descrição"]</label>
                            <InputText id="descricao" class="form-control" @bind-Value="_dados.Descricao" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="fonte">@T["Fonte"]</label>
                            <InputSelect id="fonte" class="form-select" @bind-Value="_dados.Fonte">
                                @foreach (var fonte in Enum.GetValues<TipoFonte>())
                                {
                                    <option value="@fonte">@T[Exibicao.Rotulo(fonte)]</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="criterio">@T["Critério"]</label>
                            <InputSelect id="criterio" class="form-select" @bind-Value="_dados.Criterio">
                                @foreach (var criterio in Enum.GetValues<TipoCriterio>())
                                {
                                    <option value="@criterio">@T[Exibicao.Rotulo(criterio)]</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="padrao">@T["Padrão"]</label>
                            <InputText id="padrao" class="form-control fonte-mono" @bind-Value="_dados.Padrao" />
                            <MensagemValidacao Para="() => _dados.Padrao" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="limite">@T["Limite de ocorrências"]</label>
                            <InputNumber id="limite" class="form-control" min="1" @bind-Value="_dados.LimiteOcorrencias" />
                            <MensagemValidacao Para="() => _dados.LimiteOcorrencias" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="janela">@T["Janela (segundos)"]</label>
                            <InputNumber id="janela" class="form-control" min="1" max="86400" @bind-Value="_dados.JanelaSegundos" />
                            <MensagemValidacao Para="() => _dados.JanelaSegundos" />
                        </div>
                        @if (_dados.Fonte != TipoFonte.EventoWindows)
                        {
                            <div class="col-12">
                                <label class="form-label" for="urlsIgnoradas">@T["URLs ignoradas (regex, opcional)"]</label>
                                <InputText id="urlsIgnoradas" class="form-control fonte-mono" placeholder="^POST /api/configuracao/empresa" @bind-Value="_dados.UrlsIgnoradas" />
                                <div class="form-text">@T["Requisições que casam com esta expressão não contam para a regra. Ela é testada contra a URL (ex.: ^/api/configuracao/empresa, qualquer método) e contra \"MÉTODO URL\" (ex.: ^POST /api/configuracao/empresa, só o POST). Várias rotas: separe com | (ex.: ^/favicon\\.ico|^/img/)."]</div>
                                <MensagemValidacao Para="() => _dados.UrlsIgnoradas" />
                            </div>
                        }
                    </div>
                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">@T["Salvar"]</button>
                        <a href="/Regras" class="btn btn-outline-secondary">@T["Cancelar"]</a>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="col-xl-5">
        <div class="card cartao">
            <div class="card-header"><i class="bi bi-lightbulb me-1"></i>@T["Combinações de fonte e critério"]</div>
            <div class="card-body small">
                <dl class="mb-0">
                    <dt>@T["Log IIS"]</dt>
                    <dd>@T["Código HTTP"] <code>404</code> · <code>401,403</code><br />@T["Padrão de URL (regex)"] <code>wp-login\.php|/\.env</code></dd>
                    <dt>@T["HTTPERR"]</dt>
                    <dd>@T["Motivo HTTPERR (regex)"] <code>^(BadRequest|Hostname)$</code><br />@T["Código HTTP"] <code>400</code></dd>
                    <dt>@T["Evento Windows"]</dt>
                    <dd class="mb-0">@T["ID de evento do Windows"] <code>4625,140</code> (RDP / Windows) · <code>18456</code> (SQL Server)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "id")] private int? Id { get; set; }

    private DadosFormulario _dados = new();
    private string? _erro;

    protected override async Task OnParametersSetAsync()
    {
        _erro = null;
        if (Id is null)
        {
            _dados = new DadosFormulario();
            return;
        }

        var regra = await Servicos.ExecutarAsync((ServicoRegras s) => s.ObterAsync(Id.Value));
        if (regra is null)
        {
            Avisos.Erro("Regra não encontrada.");
            Navegacao.NavigateTo("/Regras");
            return;
        }

        _dados = new DadosFormulario
        {
            Nome = regra.Nome,
            Descricao = regra.Descricao,
            Fonte = regra.Fonte,
            Criterio = regra.Criterio,
            Padrao = regra.Padrao,
            LimiteOcorrencias = regra.LimiteOcorrencias,
            JanelaSegundos = regra.JanelaSegundos,
            Ativa = regra.Ativa,
            UrlsIgnoradas = regra.UrlsIgnoradas
        };
    }

    private async Task SalvarAsync()
    {
        var resultado = await Servicos.ExecutarAsync((ServicoRegras s) => s.SalvarAsync(Id, new DadosRegra(
            _dados.Nome, _dados.Descricao, _dados.Fonte, _dados.Criterio, _dados.Padrao,
            _dados.LimiteOcorrencias, _dados.JanelaSegundos, _dados.Ativa,
            _dados.Fonte == TipoFonte.EventoWindows ? null : _dados.UrlsIgnoradas)));

        if (!resultado.Sucesso)
        {
            _erro = resultado.Erro;
            return;
        }

        Avisos.SucessoAposNavegar("Regra salva.");
        Navegacao.NavigateTo("/Regras");
    }

    private sealed class DadosFormulario
    {
        [Required(ErrorMessage = "Campo obrigatório.")]
        [StringLength(100, ErrorMessage = "Texto muito longo.")]
        public string Nome { get; set; } = string.Empty;

        [StringLength(500, ErrorMessage = "Texto muito longo.")]
        public string? Descricao { get; set; }

        public TipoFonte Fonte { get; set; } = TipoFonte.LogIis;

        public TipoCriterio Criterio { get; set; } = TipoCriterio.CodigoStatus;

        [Required(ErrorMessage = "Campo obrigatório.")]
        [StringLength(1000, ErrorMessage = "Texto muito longo.")]
        public string Padrao { get; set; } = string.Empty;

        [Range(1, 100000, ErrorMessage = "Valor fora do intervalo permitido.")]
        public int LimiteOcorrencias { get; set; } = 10;

        [Range(1, 86400, ErrorMessage = "Valor fora do intervalo permitido.")]
        public int JanelaSegundos { get; set; } = 60;

        public bool Ativa { get; set; } = true;

        [StringLength(1000, ErrorMessage = "Texto muito longo.")]
        public string? UrlsIgnoradas { get; set; }
    }
}
