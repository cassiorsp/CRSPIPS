@page "/Regras"

<Titulo Texto="@T["Regras de detecção"]" />

<div class="pagina-cheia">
<div class="row g-3 linha-cheia">
    <div class="col-xl-9">
        <div class="card cartao cartao-cheio">
            <div class="card-header d-flex align-items-center">
                <span>@T["Regras"]</span>
                <a href="/Regras/Editar" class="btn btn-sm btn-primary ms-auto"><i class="bi bi-plus-lg"></i> @T["Nova regra"]</a>
            </div>
            <div class="table-responsive tabela-rolagem">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>@T["Regra"]</th><th>@T["Fonte"]</th><th>@T["Critério"]</th><th>@T["Gatilho"]</th><th>@T["Ativa"]</th><th class="text-end">@T["Ações"]</th></tr></thead>
                    <tbody>
                    @foreach (var regra in _regras)
                    {
                        <tr @key="regra.Id" class="@(regra.Ativa ? "" : "text-body-secondary")">
                            <td>
                                <div class="fw-semibold">@regra.Nome</div>
                                @if (!string.IsNullOrEmpty(regra.Descricao))
                                {
                                    <div class="small text-body-secondary">@T[regra.Descricao]</div>
                                }
                                <code class="small text-break d-block mt-1">@regra.Padrao</code>
                            </td>
                            <td class="text-nowrap">@T[Exibicao.Rotulo(regra.Fonte)]</td>
                            <td class="small">@T[Exibicao.Rotulo(regra.Criterio)]</td>
                            <td class="text-nowrap">@T["{0} em {1}", regra.LimiteOcorrencias, Exibicao.Duracao(regra.Janela)]</td>
                            <td>
                                <div class="form-check form-switch m-0">
                                    <input class="form-check-input" type="checkbox" role="switch" checked="@regra.Ativa" aria-label="@T["Ativa"]" @onchange="() => AlternarAsync(regra.Id)" />
                                </div>
                            </td>
                            <td class="text-end text-nowrap">
                                <a href="/Regras/Editar?id=@regra.Id" class="btn btn-sm btn-outline-secondary" title="@T["Editar"]"><i class="bi bi-pencil"></i></a>
                                <button class="btn btn-sm btn-outline-danger" type="button" title="@T["Excluir"]" @onclick="() => ExcluirAsync(regra)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-xl-3">
        <div class="card cartao">
            <div class="card-header"><i class="bi bi-info-circle me-1"></i>@T["Como funciona"]</div>
            <div class="card-body small">
                <p>@T["Cada regra observa uma fonte e conta as ocorrências de cada IP dentro de uma janela deslizante. Ao atingir o limite, o IP é bloqueado."]</p>
                <p>@T["O tempo de bloqueio segue a punição progressiva definida em Configurações: cada reincidência sobe um nível."]</p>
                <p class="mb-0">@T["IPs da lista branca, do próprio servidor e usados por administradores do painel nunca são bloqueados."]</p>
            </div>
        </div>
    </div>
</div>
</div>

@code {
    private IReadOnlyList<RegraDeteccao> _regras = [];

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task CarregarAsync() => _regras = await Servicos.ExecutarAsync((ServicoRegras s) => s.ListarAsync());

    private async Task AlternarAsync(int id)
    {
        Avisos.Mostrar(await Servicos.ExecutarAsync((ServicoRegras s) => s.AlternarAtivaAsync(id)), "Regra atualizada.");
        await CarregarAsync();
    }

    private async Task ExcluirAsync(RegraDeteccao regra)
    {
        if (!await ConfirmarAsync(T["Excluir a regra {0}?", regra.Nome]))
            return;
        Avisos.Mostrar(await Servicos.ExecutarAsync((ServicoRegras s) => s.ExcluirAsync(regra.Id)), "Regra excluída.");
        await CarregarAsync();
    }
}
