@page
@model CRSP.IPS.Web.Pages.Bloqueios.DetalheModel
@{
    var detalhe = Model.Detalhe;
    var local = detalhe.Localizacao;
    ViewData["Title"] = T["Detalhe do IP"];
    var retorno = HttpContext.Request.Path + HttpContext.Request.QueryString;
}

<div class="mb-3">
    <a asp-page="/Bloqueios/Index" class="small"><i class="bi bi-arrow-left"></i> @T["Voltar para bloqueios"]</a>
</div>

<div class="card cartao mb-3">
    <div class="card-body d-flex flex-wrap gap-4 align-items-center">
        <div class="bandeira-grande">@Exibicao.Bandeira(local?.PaisCodigo)</div>
        <div>
            <div class="ip-grande fonte-mono">@detalhe.Ip</div>
            <div class="text-body-secondary">
                @Exibicao.NomePais(local?.PaisCodigo, local?.PaisNome)@if (!string.IsNullOrEmpty(local?.Cidade)) {<span> · @local!.Cidade</span>}
                @if (local?.Asn is not null)
                {
                    <span> · AS@(local.Asn) @local.Organizacao</span>
                }
            </div>
            <div class="d-flex flex-wrap gap-2 mt-2">
                @if (detalhe.Protegido)
                {
                    <span class="badge text-bg-success"><i class="bi bi-shield-check"></i> @T["Protegido"]: @T[detalhe.MotivoProtecao ?? string.Empty]</span>
                }
                @if (detalhe.NaListaNegra)
                {
                    <span class="badge text-bg-dark"><i class="bi bi-slash-circle"></i> @T["Lista negra"]</span>
                }
                @foreach (var (lista, referencia) in detalhe.ListasExternas)
                {
                    @if (referencia is not null && referencia.StartsWith("SBL", StringComparison.OrdinalIgnoreCase))
                    {
                        <a class="badge text-bg-danger text-decoration-none" href="https://check.spamhaus.org/sbl/query/@referencia" target="_blank" rel="noopener noreferrer">
                            <i class="bi bi-cloud-download"></i> @lista · @referencia
                        </a>
                    }
                    else
                    {
                        <span class="badge text-bg-danger"><i class="bi bi-cloud-download"></i> @lista@(referencia is null ? "" : $" · {referencia}")</span>
                    }
                }
                @if (detalhe.BloqueioAtivo is { } ativo)
                {
                    var situacao = Exibicao.SituacaoBloqueio(ativo);
                    <span class="badge @situacao.Classe">@T[situacao.Texto] · @(ativo.EhPermanente ? T["Permanente"] : T["até {0}", Exibicao.DataHora(ativo.ExpiraEm)])</span>
                }
                else if (!detalhe.NaListaNegra)
                {
                    <span class="badge text-bg-secondary">@T["Sem bloqueio ativo"]</span>
                }
            </div>
        </div>
        <div class="ms-auto d-flex flex-wrap gap-2">
            @if (detalhe.BloqueioAtivo is { } bloqueioAtivo)
            {
                <form method="post" asp-page="/Bloqueios/Index" asp-page-handler="Desbloquear">
                    <input type="hidden" name="id" value="@bloqueioAtivo.Id" />
                    <input type="hidden" name="retorno" value="@retorno" />
                    <button class="btn btn-success" type="submit"><i class="bi bi-unlock"></i> @T["Desbloquear"]</button>
                </form>
            }
            else if (!detalhe.Protegido)
            {
                <form method="post" asp-page="/Bloqueios/Index" asp-page-handler="Bloquear" class="d-flex gap-2">
                    <input type="hidden" name="ip" value="@detalhe.Ip" />
                    <input type="hidden" name="retorno" value="@retorno" />
                    <select class="form-select" name="duracao" aria-label="@T["Duração"]">
                        @foreach (var opcao in Exibicao.OpcoesDuracao)
                        {
                            <option value="@opcao.Valor" selected="@(opcao.Valor == "24h")">@T[opcao.Texto]</option>
                        }
                    </select>
                    <button class="btn btn-danger text-nowrap" type="submit"><i class="bi bi-slash-circle"></i> @T["Bloquear"]</button>
                </form>
            }
            @if (!detalhe.Protegido)
            {
                <form method="post" asp-page="/Bloqueios/Index" asp-page-handler="ListaBranca" data-confirmar="@T["Adicionar {0} à lista branca? O IP nunca mais será bloqueado.", detalhe.Ip]">
                    <input type="hidden" name="ip" value="@detalhe.Ip" />
                    <input type="hidden" name="retorno" value="@retorno" />
                    <button class="btn btn-outline-success" type="submit"><i class="bi bi-shield-check"></i> @T["Lista branca"]</button>
                </form>
            }
            <a class="btn btn-outline-secondary" href="https://www.abuseipdb.com/check/@detalhe.Ip" target="_blank" rel="noopener noreferrer">
                <i class="bi bi-box-arrow-up-right"></i> AbuseIPDB
            </a>
        </div>
    </div>
</div>

<ul class="nav nav-tabs mb-0" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#abaHistorico" type="button">@T["Histórico de bloqueios"] <span class="badge text-bg-secondary">@detalhe.Historico.Count</span></button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#abaEventos" type="button">@T["Eventos registrados"] <span class="badge text-bg-secondary">@detalhe.Eventos.Count</span></button></li>
</ul>
<div class="tab-content card cartao border-top-0 rounded-top-0">
    <div class="tab-pane fade show active" id="abaHistorico">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead><tr><th>@T["Bloqueado em"]</th><th>@T["Motivo"]</th><th>@T["Origem"]</th><th class="text-center">@T["Nível"]</th><th class="text-end">@T["Ocorr."]</th><th>@T["Expira em"]</th><th>@T["Encerrado"]</th><th>@T["Situação"]</th><th>@T["Comentário"]</th></tr></thead>
                <tbody>
                @foreach (var bloqueio in detalhe.Historico)
                {
                    var situacao = Exibicao.SituacaoBloqueio(bloqueio);
                    <tr>
                        <td class="small">@Exibicao.DataHora(bloqueio.BloqueadoEm)</td>
                        <td>@T[bloqueio.Motivo]</td>
                        <td class="small">@T[Exibicao.Rotulo(bloqueio.Origem)] · @bloqueio.CriadoPor</td>
                        <td class="text-center">@bloqueio.NivelReincidencia</td>
                        <td class="text-end">@bloqueio.Ocorrencias</td>
                        <td class="small">@(bloqueio.EhPermanente ? T["Permanente"].Value : Exibicao.DataHora(bloqueio.ExpiraEm))</td>
                        <td class="small">@Exibicao.DataHora(bloqueio.EncerradoEm) @bloqueio.EncerradoPor</td>
                        <td><span class="badge @situacao.Classe">@T[situacao.Texto]</span></td>
                        <td class="small text-break">@bloqueio.Comentario</td>
                    </tr>
                }
                @if (detalhe.Historico.Count == 0)
                {
                    <tr><td colspan="9" class="text-body-secondary">@T["Este IP nunca foi bloqueado."]</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <div class="tab-pane fade" id="abaEventos">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead><tr><th>@T["Quando"]</th><th>@T["Fonte"]</th><th>@T["Regra"]</th><th>@T["Site"]</th><th>@T["Requisição"]</th><th>@T["Status"]</th><th>@T["Detalhe"]</th></tr></thead>
                <tbody>
                @foreach (var evento in detalhe.Eventos)
                {
                    <tr>
                        <td class="small text-nowrap">@Exibicao.DataHora(evento.OcorridoEmUtc)</td>
                        <td class="small">@T[Exibicao.Rotulo(evento.Fonte)]</td>
                        <td class="small">@(evento.Regra ?? T["Política de países"].Value)</td>
                        <td class="small text-nowrap">@(evento.Site ?? "—")</td>
                        <td class="small fonte-mono text-break">@evento.Metodo @evento.Url</td>
                        <td>@evento.CodigoStatus</td>
                        <td class="small text-break">@(evento.Detalhe ?? evento.UserAgent)</td>
                    </tr>
                }
                @if (detalhe.Eventos.Count == 0)
                {
                    <tr><td colspan="7" class="text-body-secondary">@T["Nenhum evento registrado para este IP."]</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
