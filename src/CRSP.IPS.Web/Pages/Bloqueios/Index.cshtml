@page
@model CRSP.IPS.Web.Pages.Bloqueios.IndexModel
@{
    ViewData["Title"] = T["Bloqueios"];
    var retorno = HttpContext.Request.Path + HttpContext.Request.QueryString;
}

<div class="card cartao mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-6 col-xl-4">
                <label class="form-label small" for="Busca">@T["Buscar IP ou faixa"]</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input class="form-control fonte-mono" id="Busca" name="Busca" value="@Model.Busca" placeholder="203.0.113.7 · 203.0.113.0/24" />
                </div>
            </div>
            <div class="col-6 col-md-3 col-xl-2">
                <label class="form-label small" for="Status">@T["Status"]</label>
                <select class="form-select" id="Status" name="Status">
                    <option value="">@T["Todos"]</option>
                    @foreach (var valor in Enum.GetValues<StatusBloqueio>())
                    {
                        <option value="@valor" selected="@(Model.Status == valor)">@T[Exibicao.Rotulo(valor)]</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3 col-xl-2">
                <label class="form-label small" for="Origem">@T["Origem"]</label>
                <select class="form-select" id="Origem" name="Origem">
                    <option value="">@T["Todas"]</option>
                    @foreach (var valor in Enum.GetValues<OrigemBloqueio>())
                    {
                        <option value="@valor" selected="@(Model.Origem == valor)">@T[Exibicao.Rotulo(valor)]</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3 col-xl-2">
                <label class="form-label small" for="RegraId">@T["Regra"]</label>
                <select class="form-select" id="RegraId" name="RegraId">
                    <option value="">@T["Todas"]</option>
                    @foreach (var regra in Model.Regras)
                    {
                        <option value="@regra.Id" selected="@(Model.RegraId == regra.Id)">@regra.Nome</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3 col-xl-2">
                <label class="form-label small" for="Pais">@T["País"]</label>
                <input class="form-control text-uppercase" id="Pais" name="Pais" value="@Model.Pais" maxlength="2" placeholder="BR" />
            </div>
            <div class="col-6 col-md-3 col-xl-2">
                <label class="form-label small" for="Simulado">@T["Tipo"]</label>
                <select class="form-select" id="Simulado" name="Simulado">
                    <option value="">@T["Todos"]</option>
                    <option value="false" selected="@(Model.Simulado == false)">@T["Reais"]</option>
                    <option value="true" selected="@(Model.Simulado == true)">@T["Simulados"]</option>
                </select>
            </div>
            <div class="col-6 col-md-3 col-xl-2">
                <label class="form-label small" for="De">@T["De"]</label>
                <input type="date" class="form-control" id="De" name="De" value="@Model.De?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-6 col-md-3 col-xl-2">
                <label class="form-label small" for="Ate">@T["Até"]</label>
                <input type="date" class="form-control" id="Ate" name="Ate" value="@Model.Ate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-auto d-flex gap-2">
                <button class="btn btn-primary" type="submit"><i class="bi bi-funnel"></i> @T["Filtrar"]</button>
                <a class="btn btn-outline-secondary" asp-page="/Bloqueios/Index">@T["Limpar"]</a>
            </div>
        </form>
    </div>
</div>

<div class="card cartao">
    <div class="card-header d-flex flex-wrap gap-2 align-items-center">
        <span>@T["Histórico e status dos IPs"]</span>
        <div class="ms-auto d-flex gap-2">
            <button class="btn btn-sm btn-outline-success" type="button" data-bs-toggle="modal" data-bs-target="#modalDesbloquearSelecionados" data-requer-selecao disabled>
                <i class="bi bi-unlock"></i> @T["Desbloquear selecionados"]
            </button>
            <button class="btn btn-sm btn-danger" type="button" data-bs-toggle="modal" data-bs-target="#modalBloquear">
                <i class="bi bi-slash-circle"></i> @T["Bloquear IP"]
            </button>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 tabela-bloqueios">
            <thead>
            <tr>
                <th style="width: 32px"><input class="form-check-input" type="checkbox" data-selecionar-todos /></th>
                <th>@T["IP"]</th>
                <th>@T["Localização"]</th>
                <th>@T["Motivo"]</th>
                <th class="text-end">@T["Ocorr."]</th>
                <th class="text-center">@T["Nível"]</th>
                <th>@T["Bloqueado em"]</th>
                <th>@T["Expira em"]</th>
                <th>@T["Situação"]</th>
                <th class="text-end">@T["Ações"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var bloqueio in Model.Resultado.Itens)
            {
                var situacao = Exibicao.SituacaoBloqueio(bloqueio);
                var ativo = bloqueio.Status == StatusBloqueio.Ativo;
                <tr>
                    <td>
                        @if (ativo)
                        {
                            <input class="form-check-input" type="checkbox" value="@bloqueio.Id" data-selecao />
                        }
                    </td>
                    <td>
                        <a asp-page="/Bloqueios/Detalhe" asp-route-ip="@bloqueio.Ip" class="fonte-mono fw-semibold">@bloqueio.Ip</a>
                        @if (!string.IsNullOrEmpty(bloqueio.Organizacao))
                        {
                            <div class="small text-body-secondary text-truncate" style="max-width: 220px" title="AS@(bloqueio.Asn) @bloqueio.Organizacao">AS@(bloqueio.Asn) · @bloqueio.Organizacao</div>
                        }
                    </td>
                    <td>
                        @Exibicao.Bandeira(bloqueio.PaisCodigo)
                        <span>@Exibicao.NomePais(bloqueio.PaisCodigo, bloqueio.PaisNome)</span>
                        @if (!string.IsNullOrEmpty(bloqueio.Cidade))
                        {
                            <div class="small text-body-secondary">@bloqueio.Cidade</div>
                        }
                    </td>
                    <td>
                        <div>@T[bloqueio.Motivo]</div>
                        <div class="small text-body-secondary">@T[Exibicao.Rotulo(bloqueio.Origem)] · @bloqueio.CriadoPor</div>
                    </td>
                    <td class="text-end">@bloqueio.Ocorrencias.ToString("N0")</td>
                    <td class="text-center"><span class="badge rounded-pill text-bg-light border">@bloqueio.NivelReincidencia</span></td>
                    <td class="small">@Exibicao.DataHora(bloqueio.BloqueadoEm)</td>
                    <td class="small">
                        @if (!ativo)
                        {
                            <span class="text-body-secondary">@Exibicao.DataHora(bloqueio.EncerradoEm)</span>
                        }
                        else if (bloqueio.EhPermanente)
                        {
                            <span class="badge text-bg-dark">@T["Permanente"]</span>
                        }
                        else
                        {
                            @Exibicao.DataHora(bloqueio.ExpiraEm)
                        }
                    </td>
                    <td><span class="badge @situacao.Classe">@T[situacao.Texto]</span></td>
                    <td class="text-end">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown" type="button" aria-label="@T["Ações"]"><i class="bi bi-three-dots"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-page="/Bloqueios/Detalhe" asp-route-ip="@bloqueio.Ip"><i class="bi bi-search me-2"></i>@T["Detalhes do IP"]</a></li>
                                @if (ativo)
                                {
                                    <li>
                                        <button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#modalDesbloquear" data-id="@bloqueio.Id" data-ip="@bloqueio.Ip">
                                            <i class="bi bi-unlock me-2"></i>@T["Desbloquear"]
                                        </button>
                                    </li>
                                    <li>
                                        <button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#modalExpiracao" data-id="@bloqueio.Id" data-ip="@bloqueio.Ip">
                                            <i class="bi bi-hourglass-split me-2"></i>@T["Alterar expiração"]
                                        </button>
                                    </li>
                                }
                                <li>
                                    <form method="post" asp-page-handler="ListaBranca" data-confirmar="@T["Adicionar {0} à lista branca? O IP nunca mais será bloqueado.", bloqueio.Ip]">
                                        <input type="hidden" name="ip" value="@bloqueio.Ip" />
                                        <input type="hidden" name="retorno" value="@retorno" />
                                        <button class="dropdown-item" type="submit"><i class="bi bi-shield-check me-2"></i>@T["Adicionar à lista branca"]</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Resultado.Itens.Count == 0)
            {
                <tr><td colspan="10" class="text-center text-body-secondary py-4">@T["Nenhum bloqueio encontrado para os filtros informados."]</td></tr>
            }
            </tbody>
        </table>
    </div>
    <div class="card-body pt-0">
        <partial name="_Paginacao" model="(Model.Resultado.PaginaAtual, Model.Resultado.TotalPaginas, Model.Resultado.Total)" />
    </div>
</div>

<div class="modal fade" id="modalBloquear" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Bloquear" class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5"><i class="bi bi-slash-circle text-danger me-2"></i>@T["Bloquear IP"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Fechar"]"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="retorno" value="@retorno" />
                <div class="mb-3">
                    <label class="form-label" for="bloquearIp">@T["Endereço IP"]</label>
                    <input class="form-control fonte-mono" id="bloquearIp" name="ip" required placeholder="203.0.113.7" />
                    <div class="form-text">@T["Para bloquear uma faixa inteira, use a lista negra."]</div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="bloquearDuracao">@T["Duração"]</label>
                    <select class="form-select" id="bloquearDuracao" name="duracao">
                        @foreach (var opcao in Exibicao.OpcoesDuracao)
                        {
                            <option value="@opcao.Valor" selected="@(opcao.Valor == "24h")">@T[opcao.Texto]</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="bloquearComentario">@T["Comentário"]</label>
                    <textarea class="form-control" id="bloquearComentario" name="comentario" rows="2" maxlength="500"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T["Cancelar"]</button>
                <button type="submit" class="btn btn-danger">@T["Bloquear"]</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="modalDesbloquear" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Desbloquear" class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5"><i class="bi bi-unlock text-success me-2"></i>@T["Desbloquear"] <span class="fonte-mono" data-campo="ip"></span></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Fechar"]"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="id" data-campo="id" />
                <input type="hidden" name="retorno" value="@retorno" />
                <label class="form-label" for="desbloquearComentario">@T["Comentário"]</label>
                <textarea class="form-control" id="desbloquearComentario" name="comentario" rows="2" maxlength="500"></textarea>
                <div class="form-text">@T["Se o IP continuar gerando eventos, ele pode ser bloqueado novamente. Para liberar em definitivo, use a lista branca."]</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T["Cancelar"]</button>
                <button type="submit" class="btn btn-success">@T["Desbloquear"]</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="modalExpiracao" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="AlterarExpiracao" class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5"><i class="bi bi-hourglass-split me-2"></i>@T["Alterar expiração"] <span class="fonte-mono" data-campo="ip"></span></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Fechar"]"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="id" data-campo="id" />
                <input type="hidden" name="retorno" value="@retorno" />
                <label class="form-label" for="expiracaoDuracao">@T["Bloquear por mais (a partir de agora)"]</label>
                <select class="form-select" id="expiracaoDuracao" name="duracao">
                    @foreach (var opcao in Exibicao.OpcoesDuracao)
                    {
                        <option value="@opcao.Valor">@T[opcao.Texto]</option>
                    }
                </select>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T["Cancelar"]</button>
                <button type="submit" class="btn btn-primary">@T["Salvar"]</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="modalDesbloquearSelecionados" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="DesbloquearSelecionados" class="modal-content" data-form-selecao>
            <div class="modal-header">
                <h2 class="modal-title h5"><i class="bi bi-unlock text-success me-2"></i>@T["Desbloquear selecionados"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Fechar"]"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="retorno" value="@retorno" />
                <p>@T["IPs selecionados:"] <strong data-contador-selecao>0</strong></p>
                <label class="form-label" for="loteComentario">@T["Comentário"]</label>
                <textarea class="form-control" id="loteComentario" name="comentario" rows="2" maxlength="500"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T["Cancelar"]</button>
                <button type="submit" class="btn btn-success">@T["Desbloquear"]</button>
            </div>
        </form>
    </div>
</div>
