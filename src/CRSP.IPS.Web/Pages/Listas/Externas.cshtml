@page
@model CRSP.IPS.Web.Pages.Listas.ExternasModel
@{
    ViewData["Title"] = T["Listas"];
}
<ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link" asp-page="/Listas/Index" asp-route-tipo="Branca"><i class="bi bi-shield-check me-1"></i>@T["Lista branca"]</a></li>
    <li class="nav-item"><a class="nav-link" asp-page="/Listas/Index" asp-route-tipo="Negra"><i class="bi bi-slash-circle me-1"></i>@T["Lista negra"]</a></li>
    <li class="nav-item"><a class="nav-link active" asp-page="/Listas/Externas"><i class="bi bi-cloud-download me-1"></i>@T["Listas externas"]</a></li>
</ul>

@if (Model.ModoSimulacao)
{
    <div class="alert alert-info small">
        <i class="bi bi-eye me-1"></i>@T["Modo simulação: as listas são baixadas e as coincidências são registradas, mas nada é aplicado no firewall."]
    </div>
}

<div class="row g-3 mb-4">
    @foreach (var lista in Model.Listas)
    {
        <div class="col-xl-6">
            <div class="card cartao h-100 @(lista.EstaEmUso ? "" : "opacity-75")">
                <div class="card-body">
                    <div class="d-flex align-items-start gap-2">
                        <div>
                            <h2 class="h6 mb-1">@lista.Nome</h2>
                            <div class="small text-body-secondary">@T[lista.Descricao ?? string.Empty]</div>
                        </div>
                        <div class="ms-auto text-nowrap">
                            @switch (lista.Modo)
                            {
                                case ModoListaExterna.Desativada:
                                    <span class="badge text-bg-secondary">@T["Desativada"]</span>
                                    break;
                                case ModoListaExterna.Avaliacao:
                                    <span class="badge text-bg-warning">@T["Em avaliação"]</span>
                                    break;
                                default:
                                    if (Model.ModoSimulacao)
                                    {
                                        <span class="badge text-bg-info">@T["Ativa (simulação)"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-success">@T["Aplicada no firewall"]</span>
                                    }
                                    break;
                            }
                        </div>
                    </div>

                    <dl class="lista-dados small mt-3 mb-3">
                        <dt>@T["Faixas"]</dt>
                        <dd>@lista.Quantidade.ToString("N0") @if (lista.Removidas > 0) {<span class="text-warning-emphasis">(@T["{0} removidas pela proteção", lista.Removidas.ToString("N0")])</span>}</dd>
                        <dt>@T["Última atualização"]</dt>
                        <dd>@Exibicao.DataHora(lista.UltimaAtualizacaoEm)</dd>
                        @if (lista.EstaEmUso)
                        {
                            <dt>@T["Próxima verificação"]</dt>
                            <dd>@(lista.AtualizacaoSolicitada || lista.UltimaVerificacaoEm is null ? T["em até 1 minuto"].Value : Exibicao.DataHora(lista.ProximaAtualizacaoEm))</dd>
                        }
                        <dt>@T["Fonte"]</dt>
                        <dd class="text-break">
                            @foreach (var url in lista.ObterUrls())
                            {
                                <div class="fonte-mono">@url</div>
                            }
                        </dd>
                        @if (!string.IsNullOrEmpty(lista.UltimoErro))
                        {
                            <dt class="text-danger">@T["Último erro"]</dt>
                            <dd class="text-danger">@Exibicao.DataHora(lista.UltimaVerificacaoEm): @T[lista.UltimoErro]</dd>
                        }
                    </dl>

                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <form method="post" asp-page-handler="Modo" asp-route-id="@lista.Id" class="btn-group btn-group-sm" role="group">
                            @foreach (var (modo, rotulo) in new[] { (ModoListaExterna.Desativada, "Desativada"), (ModoListaExterna.Avaliacao, "Avaliação"), (ModoListaExterna.Ativa, "Ativa") })
                            {
                                <button type="submit" name="modo" value="@modo" class="btn @(lista.Modo == modo ? "btn-primary" : "btn-outline-primary")" disabled="@(lista.Modo == modo)">@T[rotulo]</button>
                            }
                        </form>
                        @if (lista.EstaEmUso)
                        {
                            <form method="post" asp-page-handler="Atualizar" asp-route-id="@lista.Id">
                                <button class="btn btn-sm btn-outline-primary" type="submit"><i class="bi bi-arrow-repeat"></i> @T["Atualizar agora"]</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="card cartao">
    <div class="card-header">
        <i class="bi bi-intersect me-1"></i>@T["Coincidências com o tráfego real"]
    </div>
    <div class="card-body small text-body-secondary pb-2">
        @T["IPs de alguma lista (em avaliação ou ativa) que chegaram ao servidor. Use para avaliar uma lista antes de ativá-la: varreduras e ataques confirmam a lista; acessos normais de operadoras brasileiras ou de parceiros indicam risco de bloquear usuários legítimos."]
    </div>
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead>
            <tr><th>@T["Lista"]</th><th>@T["IP"]</th><th class="text-end">@T["Acessos"]</th><th>@T["Último acesso"]</th><th>@T["Site"]</th><th>@T["Requisição"]</th><th>@T["Status"]</th></tr>
            </thead>
            <tbody>
            @foreach (var coincidencia in Model.Coincidencias)
            {
                <tr>
                    <td class="small text-nowrap">@Model.NomeLista(coincidencia.ListaExternaId)</td>
                    <td>
                        @Exibicao.Bandeira(Model.PaisDoIp(coincidencia.Ip))
                        <a asp-page="/Bloqueios/Detalhe" asp-route-ip="@coincidencia.Ip" class="fonte-mono">@coincidencia.Ip</a>
                        @if (Model.DescreverLocal(coincidencia.Ip) is { Length: > 0 } local)
                        {
                            <div class="small text-body-secondary text-nowrap">@local</div>
                        }
                    </td>
                    <td class="text-end">@coincidencia.Quantidade.ToString("N0")</td>
                    <td class="small text-nowrap">@Exibicao.DataHora(coincidencia.UltimaEm)</td>
                    <td class="small text-nowrap">@(coincidencia.UltimoSite ?? T[Exibicao.Rotulo(coincidencia.UltimaFonte)].Value)</td>
                    <td class="small fonte-mono text-break">@coincidencia.UltimaUrl</td>
                    <td>@coincidencia.UltimoCodigoStatus</td>
                </tr>
            }
            @if (Model.Coincidencias.Count == 0)
            {
                <tr><td colspan="7" class="text-body-secondary">@T["Nenhuma coincidência registrada."]</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
