@page
@model CRSP.IPS.Web.Pages.Listas.IndexModel
@{
    ViewData["Title"] = T["Listas"];
    var branca = Model.Tipo == TipoLista.Branca;
}
<ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link @(branca ? "active" : "")" asp-page="/Listas/Index" asp-route-tipo="Branca"><i class="bi bi-shield-check me-1"></i>@T["Lista branca"]</a></li>
    <li class="nav-item"><a class="nav-link @(!branca ? "active" : "")" asp-page="/Listas/Index" asp-route-tipo="Negra"><i class="bi bi-slash-circle me-1"></i>@T["Lista negra"]</a></li>
    <li class="nav-item"><a class="nav-link" asp-page="/Listas/Externas"><i class="bi bi-cloud-download me-1"></i>@T["Listas externas"]</a></li>
</ul>

<div class="row g-3">
    <div class="col-xl-8">
        <div class="card cartao">
            <div class="card-body border-bottom">
                <form method="post" asp-page-handler="Adicionar" asp-route-tipo="@Model.Tipo" class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label small" for="faixa">@T["IP, CIDR ou intervalo"]</label>
                        <input class="form-control fonte-mono" id="faixa" name="faixa" required placeholder="203.0.113.0/24" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small" for="descricao">@T["Descrição"]</label>
                        <input class="form-control" id="descricao" name="descricao" maxlength="300" />
                    </div>
                    <div class="col-md-2">
                        <button class="btn @(branca ? "btn-success" : "btn-dark") w-100" type="submit"><i class="bi bi-plus-lg"></i> @T["Adicionar"]</button>
                    </div>
                </form>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>@T["Faixa"]</th><th>@T["Descrição"]</th><th>@T["Incluído em"]</th><th>@T["Por"]</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var entrada in Model.Entradas)
                    {
                        <tr>
                            <td class="fonte-mono">@entrada.Faixa @if (entrada.Sistema) {<span class="badge text-bg-secondary ms-1">@T["Sistema"]</span>}</td>
                            <td>@T[entrada.Descricao ?? string.Empty]</td>
                            <td class="small">@Exibicao.DataHora(entrada.CriadaEm)</td>
                            <td class="small">@entrada.CriadaPor</td>
                            <td class="text-end">
                                @if (!entrada.Sistema)
                                {
                                    <form method="post" asp-page-handler="Remover" asp-route-id="@entrada.Id" asp-route-tipo="@Model.Tipo" data-confirmar="@T["Remover {0}?", entrada.Faixa]">
                                        <button class="btn btn-sm btn-outline-danger" type="submit" title="@T["Remover"]"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Entradas.Count == 0)
                    {
                        <tr><td colspan="5" class="text-body-secondary">@T["Lista vazia."]</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card cartao">
            <div class="card-header"><i class="bi bi-info-circle me-1"></i>@(branca ? T["Lista branca"] : T["Lista negra"])</div>
            <div class="card-body small">
                @if (branca)
                {
                    <p>@T["Endereços da lista branca nunca são bloqueados, nem por regra nem manualmente. Ao incluir uma faixa, os bloqueios ativos dentro dela são liberados."]</p>
                    <p>@T["Inclua aqui o IP fixo da empresa, VPN, monitoramento e parceiros de integração."]</p>
                    <p class="mb-0 text-warning-emphasis"><i class="bi bi-exclamation-triangle"></i> @T["Se o servidor fica atrás de NAT ou proxy e os logs mostram um IP interno para todo o tráfego, mantenha as redes privadas aqui: bloquear o proxy derrubaria todos os acessos."]</p>
                }
                else
                {
                    <p>@T["Endereços da lista negra são bloqueados permanentemente no firewall, em todas as portas."]</p>
                    <p class="mb-0">@T["Não é possível incluir faixas que contenham endereços protegidos."]</p>
                }
                <hr />
                <p class="mb-0 text-body-secondary">@T["Formatos aceitos:"] <code>203.0.113.7</code> · <code>203.0.113.0/24</code> · <code>203.0.113.1-203.0.113.50</code> · <code>2001:db8::/32</code></p>
            </div>
        </div>
    </div>
</div>
