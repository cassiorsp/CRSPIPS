@page
@model CRSP.IPS.Web.Pages.Regras.EditarModel
@{
    ViewData["Title"] = Model.Id is null ? T["Nova regra"] : T["Editar regra"];
}
<div class="mb-3">
    <a asp-page="/Regras/Index" class="small"><i class="bi bi-arrow-left"></i> @T["Voltar para regras"]</a>
</div>
<div class="row g-3">
    <div class="col-xl-7">
        <div class="card cartao">
            <div class="card-body">
                <form method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Dados.Nome" class="form-label"></label>
                            <input asp-for="Dados.Nome" class="form-control" />
                            <span asp-validation-for="Dados.Nome" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                <input asp-for="Dados.Ativa" class="form-check-input" role="switch" />
                                <label asp-for="Dados.Ativa" class="form-check-label"></label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Dados.Descricao" class="form-label"></label>
                            <input asp-for="Dados.Descricao" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Dados.Fonte" class="form-label"></label>
                            <select asp-for="Dados.Fonte" class="form-select">
                                @foreach (var fonte in Enum.GetValues<TipoFonte>())
                                {
                                    <option value="@fonte">@T[Exibicao.Rotulo(fonte)]</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Dados.Criterio" class="form-label"></label>
                            <select asp-for="Dados.Criterio" class="form-select">
                                @foreach (var criterio in Enum.GetValues<TipoCriterio>())
                                {
                                    <option value="@criterio">@T[Exibicao.Rotulo(criterio)]</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label asp-for="Dados.Padrao" class="form-label"></label>
                            <input asp-for="Dados.Padrao" class="form-control fonte-mono" />
                            <span asp-validation-for="Dados.Padrao" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Dados.LimiteOcorrencias" class="form-label"></label>
                            <input asp-for="Dados.LimiteOcorrencias" class="form-control" type="number" min="1" />
                            <span asp-validation-for="Dados.LimiteOcorrencias" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Dados.JanelaSegundos" class="form-label"></label>
                            <input asp-for="Dados.JanelaSegundos" class="form-control" type="number" min="1" max="86400" />
                            <span asp-validation-for="Dados.JanelaSegundos" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">@T["Salvar"]</button>
                        <a asp-page="/Regras/Index" class="btn btn-outline-secondary">@T["Cancelar"]</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-xl-5">
        <div class="card cartao">
            <div class="card-header"><i class="bi bi-lightbulb me-1"></i>@T["Combinações de fonte e critério"]</div>
            <div class="card-body small">
                <dl class="mb-0">
                    <dt>@T["Log IIS"]</dt>
                    <dd>@T["Código HTTP"] <code>404</code> · <code>401,403</code><br />@T["Padrão de URL (regex)"] <code>wp-login\.php|/\.env</code></dd>
                    <dt>@T["HTTPERR"]</dt>
                    <dd>@T["Motivo HTTPERR (regex)"] <code>^(BadRequest|Hostname)$</code><br />@T["Código HTTP"] <code>400</code></dd>
                    <dt>@T["Evento Windows"]</dt>
                    <dd class="mb-0">@T["ID de evento do Windows"] <code>4625,140</code> (RDP / Windows) · <code>18456</code> (SQL Server)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
