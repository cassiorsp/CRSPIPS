@{
    var retorno = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "en" : "pt-BR")" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · CRSPIPS</title>
    <script src="~/js/tema.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="tela-acesso">
<div class="cartao-acesso">
    <div class="text-center mb-4">
        <div class="marca-acesso"><i class="bi bi-shield-shaded"></i> CRSPIPS</div>
        <div class="text-body-secondary small">@T["Sistema de Prevenção de Intrusões"]</div>
    </div>
    <partial name="_Mensagens" />
    @RenderBody()
    <div class="text-center mt-4 small">
        <a class="link-secondary" href="/idioma?cultura=pt-BR&retorno=@Uri.EscapeDataString(retorno)">Português</a>
        <span class="text-body-secondary mx-1">·</span>
        <a class="link-secondary" href="/idioma?cultura=en&retorno=@Uri.EscapeDataString(retorno)">English</a>
    </div>
</div>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
