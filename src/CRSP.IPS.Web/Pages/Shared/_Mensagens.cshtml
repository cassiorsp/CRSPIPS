@{
    var sucesso = TempData["MensagemSucesso"] as string;
    var erro = TempData["MensagemErro"] as string;
}
@if (!string.IsNullOrEmpty(sucesso))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@T[sucesso]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T["Fechar"]"></button>
    </div>
}
@if (!string.IsNullOrEmpty(erro))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@T[erro]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T["Fechar"]"></button>
    </div>
}
