@page
@model IndexModel
@{
    ViewData["Title"] = T["Dashboard"];
    var indicadores = Model.Indicadores;
    var worker = indicadores.Worker;
}

<div class="d-flex justify-content-end align-items-center gap-2 mb-2 small text-body-secondary" id="barraAtualizacao"
     data-intervalo="30" data-texto-agora="@T["Atualizado agora"]" data-texto-segundos="@T["Atualizado há {0} s"]"
     data-texto-pausar="@T["Pausar"]" data-texto-continuar="@T["Continuar"]" data-texto-falha="@T["Falha ao atualizar. Nova tentativa em instantes."]">
    <span class="ponto-vivo" id="indicadorDashboard"></span>
    <span id="textoAtualizacao">@T["Atualizado agora"]</span>
    <button class="btn btn-sm btn-link p-0 text-decoration-none" type="button" id="botaoPausarDashboard">
        <i class="bi bi-pause"></i> <span>@T["Pausar"]</span>
    </button>
    <button class="btn btn-sm btn-link p-0 text-decoration-none" type="button" id="botaoAtualizarDashboard" title="@T["Atualizar agora"]">
        <i class="bi bi-arrow-clockwise"></i>
    </button>
</div>

<div id="conteudoDashboard">
@if (indicadores.ModoSimulacao)
{
    <div class="alert alert-info d-flex align-items-center gap-2">
        <i class="bi bi-eye fs-5"></i>
        <div>
            <strong>@T["Modo simulação ativo."]</strong>
            @T["Os bloqueios automáticos são registrados, mas não são aplicados no firewall. Bloqueios manuais e a lista negra são aplicados normalmente."]
            <a asp-page="/Configuracoes/Index" class="alert-link">@T["Configurações"]</a>
        </div>
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3">
        <div class="card cartao kpi kpi-perigo">
            <div class="card-body">
                <div class="kpi-icone"><i class="bi bi-shield-lock"></i></div>
                <div class="kpi-valor">@indicadores.BloqueiosAtivos.ToString("N0")</div>
                <div class="kpi-rotulo">@T["Bloqueios ativos"]</div>
                @if (indicadores.BloqueiosSimuladosAtivos > 0)
                {
                    <div class="kpi-extra">@T["+{0} simulados", indicadores.BloqueiosSimuladosAtivos]</div>
                }
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card cartao kpi kpi-alerta">
            <div class="card-body">
                <div class="kpi-icone"><i class="bi bi-calendar-x"></i></div>
                <div class="kpi-valor">@indicadores.BloqueadosHoje.ToString("N0")</div>
                <div class="kpi-rotulo">@T["Ataques mitigados hoje"]</div>
                @if (indicadores.BloqueadosHojeSimulados > 0)
                {
                    <div class="kpi-extra">@T["+{0} simulados", indicadores.BloqueadosHojeSimulados]</div>
                }
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card cartao kpi kpi-info">
            <div class="card-body">
                <div class="kpi-icone"><i class="bi bi-activity"></i></div>
                <div class="kpi-valor">@indicadores.EventosUltimas24h.ToString("N0")</div>
                <div class="kpi-rotulo" title="@T["Eventos que casaram com alguma regra. Amostras limitadas a 20 por IP, regra e hora."]">@T["Eventos suspeitos (24h)"]</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card cartao kpi kpi-neutro">
            <div class="card-body">
                <div class="kpi-icone"><i class="bi bi-globe2"></i></div>
                <div class="kpi-valor">@indicadores.PaisesUltimas24h.ToString("N0")</div>
                <div class="kpi-rotulo">@T["Países com eventos suspeitos (24h)"]</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-xl-8">
        <div class="card cartao h-100">
            <div class="card-header">@T["Últimas 24 horas"]</div>
            <div class="card-body"><div class="grafico"><canvas id="graficoLinha"></canvas></div></div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card cartao h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>@T["Motor (Worker)"]</span>
                @if (indicadores.WorkerOnline)
                {
                    <span class="badge text-bg-success">@T["Online"]</span>
                }
                else
                {
                    <span class="badge text-bg-danger">@T["Offline"]</span>
                }
            </div>
            <div class="card-body">
                @if (worker is null)
                {
                    <p class="text-body-secondary mb-0">@T["O serviço CRSPIPS ainda não foi iniciado neste servidor."]</p>
                }
                else
                {
                    <dl class="lista-dados mb-0">
                        <dt>@T["Servidor"]</dt><dd>@worker.Maquina <span class="text-body-secondary">v@(worker.Versao)</span></dd>
                        <dt>@T["Último sinal"]</dt><dd>@Exibicao.DataHora(worker.UltimoSinalEm)</dd>
                        <dt>@T["Última sincronização"]</dt><dd>@Exibicao.DataHora(worker.UltimaSincronizacaoEm)</dd>
                        <dt>@T["Endereços no firewall"]</dt><dd>@worker.EnderecosNoFirewall.ToString("N0") <span class="text-body-secondary">(@T["{0} regras", worker.RegrasNoFirewall])</span></dd>
                        <dt>@T["Eventos processados"]</dt><dd>@worker.EventosProcessados.ToString("N0")</dd>
                        <dt>@T["Política de países"]</dt><dd>@T[Exibicao.Rotulo(indicadores.ModoPaises)]@if (!string.IsNullOrEmpty(worker.ResumoPoliticaPaises)) {<div class="small text-body-secondary">@worker.ResumoPoliticaPaises</div>}</dd>
                        @if (!string.IsNullOrEmpty(worker.UltimoErro))
                        {
                            <dt class="text-danger">@T["Último erro"]</dt>
                            <dd class="text-danger small">@Exibicao.DataHora(worker.UltimoErroEm): @worker.UltimoErro</dd>
                        }
                    </dl>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-4">
        <div class="card cartao h-100">
            <div class="card-header">@T["Eventos por fonte (24h)"]</div>
            <div class="card-body">
                @if (indicadores.EventosPorFonte.Count == 0)
                {
                    <p class="text-body-secondary mb-0">@T["Sem eventos no período."]</p>
                }
                else
                {
                    <div class="grafico grafico-baixo"><canvas id="graficoFontes"></canvas></div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card cartao h-100">
            <div class="card-header">@T["Países com mais bloqueios (7 dias)"]</div>
            <div class="card-body">
                @if (indicadores.TopPaises.Count == 0)
                {
                    <p class="text-body-secondary mb-0">@T["Sem bloqueios no período."]</p>
                }
                else
                {
                    <div class="grafico grafico-baixo"><canvas id="graficoPaises"></canvas></div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-6">
        <div class="card cartao h-100">
            <div class="card-header">@T["IPs agressores mais frequentes (30 dias)"]</div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead><tr><th>@T["IP"]</th><th>@T["País"]</th><th class="text-end">@T["Bloqueios"]</th><th class="text-end" title="@T["Eventos suspeitos registrados nos últimos 30 dias (amostras limitadas a 20 por IP, regra e hora)."]">@T["Eventos"]</th></tr></thead>
                    <tbody>
                    @foreach (var item in indicadores.TopIps)
                    {
                        var partes = (item.Complemento ?? "0|").Split('|');
                        <tr>
                            <td><a asp-page="/Bloqueios/Detalhe" asp-route-ip="@item.Rotulo" class="fonte-mono">@item.Rotulo</a></td>
                            <td>@Exibicao.Bandeira(partes.ElementAtOrDefault(1)) @partes.ElementAtOrDefault(1)</td>
                            <td class="text-end">@partes[0]</td>
                            <td class="text-end">@item.Quantidade.ToString("N0")</td>
                        </tr>
                    }
                    @if (indicadores.TopIps.Count == 0)
                    {
                        <tr><td colspan="4" class="text-body-secondary">@T["Sem eventos no período."]</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="card cartao h-100">
            <div class="card-header d-flex justify-content-between">
                <span>@T["Bloqueios recentes"]</span>
                <a asp-page="/Bloqueios/Index" class="small">@T["Ver todos"]</a>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead><tr><th>@T["IP"]</th><th>@T["Motivo"]</th><th>@T["Quando"]</th><th>@T["Situação"]</th></tr></thead>
                    <tbody>
                    @foreach (var bloqueio in indicadores.BloqueiosRecentes)
                    {
                        var situacao = Exibicao.SituacaoBloqueio(bloqueio);
                        <tr>
                            <td>@Exibicao.Bandeira(bloqueio.PaisCodigo) <a asp-page="/Bloqueios/Detalhe" asp-route-ip="@bloqueio.Ip" class="fonte-mono">@bloqueio.Ip</a></td>
                            <td class="text-truncate" style="max-width: 220px">@T[bloqueio.Motivo]</td>
                            <td class="small">@Exibicao.DataHora(bloqueio.BloqueadoEm)</td>
                            <td><span class="badge @situacao.Classe">@T[situacao.Texto]</span></td>
                        </tr>
                    }
                    @if (indicadores.BloqueiosRecentes.Count == 0)
                    {
                        <tr><td colspan="4" class="text-body-secondary">@T["Nenhum bloqueio registrado ainda."]</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="card cartao">
            <div class="card-header">@T["URLs mais atacadas (7 dias)"]</div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead><tr><th>@T["URL"]</th><th class="text-end">@T["Ocorrências"]</th></tr></thead>
                    <tbody>
                    @foreach (var item in indicadores.TopUrls)
                    {
                        <tr><td class="fonte-mono text-break">@item.Rotulo</td><td class="text-end">@item.Quantidade.ToString("N0")</td></tr>
                    }
                    @if (indicadores.TopUrls.Count == 0)
                    {
                        <tr><td colspan="2" class="text-body-secondary">@T["Sem eventos no período."]</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script type="application/json" id="dadosDashboard">@Html.Raw(Model.DadosGraficosJson)</script>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
