@page
@model Donc.IPS.Web.Pages.Monitor.IndexModel
@{
    ViewData["Title"] = T["Monitor"];
}
<div class="card cartao">
    <div class="card-header d-flex flex-wrap gap-2 align-items-center">
        <span><span class="ponto-vivo" id="indicadorVivo"></span> @T["Eventos suspeitos em tempo real"]</span>
        <div class="ms-auto d-flex gap-2">
            <select class="form-select form-select-sm" id="filtroFonte" aria-label="@T["Fonte"]">
                <option value="">@T["Todas as fontes"]</option>
                @foreach (var fonte in Enum.GetValues<TipoFonte>())
                {
                    <option value="@fonte">@T[Exibicao.Rotulo(fonte)]</option>
                }
            </select>
            <button class="btn btn-sm btn-outline-secondary text-nowrap" id="botaoPausar" type="button"
                    data-texto-pausar="@T["Pausar"]" data-texto-continuar="@T["Continuar"]">
                <i class="bi bi-pause"></i> <span>@T["Pausar"]</span>
            </button>
        </div>
    </div>
    <div class="table-responsive tabela-monitor">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="sticky-top">
            <tr><th>@T["Quando"]</th><th>@T["IP"]</th><th>@T["Fonte"]</th><th>@T["Regra"]</th><th>@T["Site"]</th><th>@T["Requisição"]</th><th>@T["Status"]</th><th>@T["Detalhe"]</th></tr>
            </thead>
            <tbody id="corpoMonitor" data-url="@Url.Page("/Monitor/Index", "Eventos")" data-url-detalhe="@Url.Page("/Bloqueios/Detalhe")"
                   data-texto-vazio="@T["Aguardando eventos. Somente eventos que casam com alguma regra aparecem aqui."]">
            </tbody>
        </table>
    </div>
    <div class="card-footer small text-body-secondary">
        @T["Atualização automática a cada 5 segundos. O IIS grava o log em disco a cada ~60 segundos, então eventos web podem aparecer com esse atraso."]
    </div>
</div>

@section Scripts {
    <script src="~/js/monitor.js" asp-append-version="true"></script>
}
