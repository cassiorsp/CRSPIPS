@{
    var paginaAtual = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    string Ativo(string prefixo) =>
        prefixo == "/Index" ? (paginaAtual == "/Index" ? "active" : "") : (paginaAtual.StartsWith(prefixo) ? "active" : "");
    var retorno = Context.Request.Path + Context.Request.QueryString;
    var culturaAtual = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
<!DOCTYPE html>
<html lang="@(culturaAtual == "en" ? "en" : "pt-BR")" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · CRSPIPS</title>
    <script src="~/js/tema.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flag-icons@7.2.3/css/flag-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app">
    <aside class="barra-lateral" id="barraLateral">
        <a class="marca" asp-page="/Index">
            <i class="bi bi-shield-shaded"></i>
            <span>CRSPIPS</span>
        </a>
        <nav class="menu">
            <div class="menu-grupo">@T["Monitoramento"]</div>
            <a class="menu-item @Ativo("/Index")" asp-page="/Index"><i class="bi bi-speedometer2"></i>@T["Dashboard"]</a>
            <a class="menu-item @Ativo("/Monitor")" asp-page="/Monitor/Index"><i class="bi bi-activity"></i>@T["Monitor"]</a>

            <div class="menu-grupo">@T["Proteção"]</div>
            <a class="menu-item @Ativo("/Bloqueios")" asp-page="/Bloqueios/Index"><i class="bi bi-slash-circle"></i>@T["Bloqueios"]</a>
            <a class="menu-item @Ativo("/Regras")" asp-page="/Regras/Index"><i class="bi bi-sliders"></i>@T["Regras de detecção"]</a>
            <a class="menu-item @Ativo("/Listas")" asp-page="/Listas/Index"><i class="bi bi-list-check"></i>@T["Listas"]</a>
            <a class="menu-item @Ativo("/Paises")" asp-page="/Paises/Index"><i class="bi bi-globe2"></i>@T["Países"]</a>

            <div class="menu-grupo">@T["Sistema"]</div>
            <a class="menu-item @Ativo("/Configuracoes")" asp-page="/Configuracoes/Index"><i class="bi bi-gear"></i>@T["Configurações"]</a>
            <a class="menu-item @Ativo("/Usuarios")" asp-page="/Usuarios/Index"><i class="bi bi-people"></i>@T["Usuários"]</a>
            <a class="menu-item @Ativo("/Auditoria")" asp-page="/Auditoria/Index"><i class="bi bi-journal-text"></i>@T["Auditoria"]</a>
        </nav>
        <div class="rodape-menu">CRSPIPS · Donc</div>
    </aside>

    <div class="conteudo">
        <header class="topo">
            <button class="btn btn-link text-reset d-lg-none" type="button" data-alternar-menu aria-label="@T["Menu"]">
                <i class="bi bi-list fs-4"></i>
            </button>
            <h1 class="topo-titulo">@ViewData["Title"]</h1>
            <div class="ms-auto d-flex align-items-center gap-2">
                <vc:status-motor />
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" type="button">
                        <i class="bi bi-translate"></i> @(culturaAtual == "en" ? "EN" : "PT")
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/idioma?cultura=pt-BR&retorno=@Uri.EscapeDataString(retorno)">Português (Brasil)</a></li>
                        <li><a class="dropdown-item" href="/idioma?cultura=en&retorno=@Uri.EscapeDataString(retorno)">English</a></li>
                    </ul>
                </div>
                <button class="btn btn-sm btn-outline-secondary" type="button" data-alternar-tema title="@T["Alternar tema"]">
                    <i class="bi bi-circle-half"></i>
                </button>
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" type="button">
                        <i class="bi bi-person-circle"></i> <span class="d-none d-md-inline">@User.Identity?.Name</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-page="/Conta/Senha"><i class="bi bi-key me-2"></i>@T["Alterar minha senha"]</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form method="post" asp-page="/Conta/Sair">
                                <button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right me-2"></i>@T["Sair"]</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="principal">
            <partial name="_Mensagens" />
            @RenderBody()
        </main>
    </div>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
