@page
@model Donc.IPS.Web.Pages.Usuarios.NovoModel
@{
    ViewData["Title"] = T["Novo usuário"];
}
<div class="mb-3">
    <a asp-page="/Usuarios/Index" class="small"><i class="bi bi-arrow-left"></i> @T["Voltar para usuários"]</a>
</div>
<div class="card cartao" style="max-width: 560px">
    <div class="card-body">
        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <div class="mb-3">
                <label asp-for="Dados.Nome" class="form-label"></label>
                <input asp-for="Dados.Nome" class="form-control" />
                <span asp-validation-for="Dados.Nome" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Dados.Email" class="form-label"></label>
                <input asp-for="Dados.Email" class="form-control" autocomplete="off" />
                <span asp-validation-for="Dados.Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Dados.Senha" class="form-label"></label>
                <input asp-for="Dados.Senha" class="form-control" autocomplete="new-password" />
                <div class="form-text">@T["Mínimo de 10 caracteres, com letras e números."]</div>
                <span asp-validation-for="Dados.Senha" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Dados.ConfirmarSenha" class="form-label"></label>
                <input asp-for="Dados.ConfirmarSenha" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Dados.ConfirmarSenha" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary">@T["Criar usuário"]</button>
        </form>
    </div>
</div>
